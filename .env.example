# Copy this file to .env and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d --build

# Postgres
POSTGRES_DB=quizapp
POSTGRES_USER=quizapp
POSTGRES_PASSWORD=changeme-use-a-real-password

# JWT signing secret. Generate one with: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# The public hostname the app will be served under (used for CORS).
# Not strictly required behind the nginx same-origin proxy, but set it anyway.
PUBLIC_ORIGIN=https://quiz.patreek.no

# Host port the frontend container publishes on 127.0.0.1.
# Point your cloudflared ingress rule's "service" at http://localhost:<this port>.
APP_PORT=8090
